<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:id="shellRoot"
            fx:controller="org.example.controllers.ShellController"
            prefHeight="640.0"
            prefWidth="960.0"
            stylesheets="@/org/example/styles/shell.css">

    <top>
        <HBox fx:id="headerBar"
              alignment="CENTER_LEFT"
              styleClass="shell-header">

            <padding>
                <Insets top="12.0" bottom="12.0" left="20.0" right="20.0"/>
            </padding>

            <Label fx:id="appTitleLabel"
                   text="OptiScan Pro"
                   styleClass="shell-title"/>
        </HBox>
    </top>

    <left>
        <VBox fx:id="sidebar"
              alignment="TOP_CENTER"
              spacing="8.0"
              styleClass="shell-sidebar">

            <padding>
                <Insets top="16.0" bottom="16.0" left="12.0" right="12.0"/>
            </padding>

            <Button fx:id="dashboardButton"
                    text="Dashboard"
                    maxWidth="Infinity"
                    onAction="#goToDashboard"
                    styleClass="shell-nav-button"/>

            <Button fx:id="programasButton"
                    text="Programas"
                    maxWidth="Infinity"
                    onAction="#goToProgramas"
                    styleClass="shell-nav-button"/>

            <Button fx:id="historialButton"
                    text="Historial"
                    maxWidth="Infinity"
                    onAction="#goToHistorial"
                    styleClass="shell-nav-button"/>

            <Button fx:id="seguridadButton"
                    text="Seguridad"
                    maxWidth="Infinity"
                    onAction="#goToSeguridad"
                    styleClass="shell-nav-button"/>

            <Button fx:id="limpiezaButton"
                    text="Limpieza"
                    maxWidth="Infinity"
                    onAction="#goToLimpieza"
                    styleClass="shell-nav-button"/>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentArea"
                   styleClass="shell-content">

            <padding>
                <Insets top="24.0" bottom="24.0" left="24.0" right="24.0"/>
            </padding>

            <Label fx:id="mainContentLabel"
                   text="Contenido principal"
                   styleClass="shell-content-label"/>
        </StackPane>
    </center>

</BorderPane>
